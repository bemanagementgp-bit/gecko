# Copiar a .env y completar. Ninguno es obligatorio para correr el sitio en local.
VITE_WHATSAPP=5492210000000
VITE_META_PIXEL_ID=
VITE_GA4_ID=
# Endpoint que recibe las consultas (CRM, Make, Zapier, backend propio). Si está vacío, las consultas se derivan a WhatsApp.
VITE_LEAD_ENDPOINT=
# Backend que crea la preferencia de Mercado Pago y devuelve { init_point }. Si está vacío, los pedidos se cierran por WhatsApp.
VITE_CHECKOUT_ENDPOINT=
# Supabase (panel de contenido). Sin estas dos variables el panel funciona en modo demo.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
